<mujoco model="end_effector">
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option timestep="0.002"/>

  <asset>
    <mesh name="end_effector_body" file="end_effector_body.stl"/>
    <mesh name="socket_ns10la" file="socket_ns10la.stl"/>
    <material name="metal" rgba="0.72 0.74 0.78 1" specular="0.35" shininess="0.6"/>
  </asset>

  <worldbody>
    <light name="key" pos="1 -1 1.5" dir="-1 1 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-1 -1 1.5" dir="1 1 -1" diffuse="0.35 0.35 0.4"/>
    <body name="end_effector" pos="0 0 0">
      <include file="parts/end_effector_body.xml"/>
    </body>
    <camera name="cam" pos="0.75 -0.55 0.35" mode="targetbodycom" target="end_effector"/>
  </worldbody>

  <statistic center="0.25 0 0" extent="0.65"/>
  <actuator>
    <velocity name="socket_velocity" joint="socket_joint" kv="0.5" ctrlrange="-100 100"/>
  </actuator>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
</mujoco>
