<body name="end_effector_parts">
  <!-- 这个文件是“零件片段”：include 时根 body 会被剥掉，下面内容合并到外层 body。
       外层 body 的名字/位姿由 end_effector.xml 或 scene.xml 决定。 -->

  <!-- 工具本体（不含套筒）：质量/惯量按网格体积与 ~2.26 g/cm^3 估算，3.95 kg -->
  <inertial pos="0.1726 0 0" mass="3.95" diaginertia="0.00518 0.05031 0.05032"/>

  <!-- 视觉网格：螺丝枪 + 法兰，不含套筒 -->
  <geom name="ee_visual" type="mesh" mesh="end_effector_body" material="metal"
        contype="0" conaffinity="0" group="2"/>

  <!-- 碰撞体：用 3 个盒体近似，避免整机凸包把中空结构填满 -->
  <geom name="ee_mount" type="box" size="0.0075 0.065 0.065" pos="0 0 0" group="3"
        contype="1" conaffinity="2"/>
  <geom name="ee_body" type="box" size="0.1625 0.065 0.065" pos="0.170 0 0" group="3"
        contype="1" conaffinity="2"/>
  <geom name="ee_gun" type="box" size="0.0865 0.04275 0.031" pos="0.3494 -0.01175 0" group="3"
        contype="1" conaffinity="2"/>

  <!-- 安装法兰中心（机器人腕部对接点），工具沿 +X 伸出 -->
  <site name="mount" pos="0 0 0" size="0.02 0.02 0.02" rgba="0.9 0.2 0.2 0.6"/>

  <!-- NS.10LA 套筒：绕自身轴线（工具 +X）旋转 -->
  <body name="socket" pos="0.4589 0 0">
    <joint name="socket_joint" type="hinge" axis="1 0 0"
           damping="0.2" frictionloss="0.001" armature="0.01"/>
    <inertial pos="-0.0054 0 0" mass="0.05" diaginertia="3.8e-6 2.14e-5 2.14e-5"/>

    <geom name="socket_visual" type="mesh" mesh="socket_ns10la" material="metal"
          contype="0" conaffinity="0" group="2"/>
    <geom name="socket_wall_0" type="box" pos="0.036 0.005066 0.002925" quat="0.9659258 0.258819 0 0" size="0.003 0.0007 0.006" group="3" condim="4" friction="1 0.02 0.01" contype="1" conaffinity="2"/>
    <geom name="socket_wall_1" type="box" pos="0.036 0 0.00585" quat="0.7071068 0.7071068 0 0" size="0.003 0.0007 0.006" group="3" condim="4" friction="1 0.02 0.01" contype="1" conaffinity="2"/>
    <geom name="socket_wall_2" type="box" pos="0.036 -0.005066 0.002925" quat="0.258819 0.9659258 0 0" size="0.003 0.0007 0.006" group="3" condim="4" friction="1 0.02 0.01" contype="1" conaffinity="2"/>
    <geom name="socket_wall_3" type="box" pos="0.036 -0.005066 -0.002925" quat="-0.258819 0.9659258 0 0" size="0.003 0.0007 0.006" group="3" condim="4" friction="1 0.02 0.01" contype="1" conaffinity="2"/>
    <geom name="socket_wall_4" type="box" pos="0.036 0 -0.00585" quat="-0.7071068 0.7071068 0 0" size="0.003 0.0007 0.006" group="3" condim="4" friction="1 0.02 0.01" contype="1" conaffinity="2"/>
    <geom name="socket_wall_5" type="box" pos="0.036 0.005066 -0.002925" quat="-0.9659258 0.258819 0 0" size="0.003 0.0007 0.006" group="3" condim="4" friction="1 0.02 0.01" contype="1" conaffinity="2"/>

    <site name="socket_center" pos="0 0 0" size="0.008 0.008 0.008" rgba="0.2 0.9 0.2 0.6"/>
    <site name="tool_tip" pos="0.039 0 0" size="0.008 0.008 0.008" rgba="0.2 0.9 0.2 0.6"/>
  </body>
</body>
