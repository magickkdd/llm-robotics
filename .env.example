# Copy to .env (git-ignored) and fill in: cp .env.example .env && chmod 600 .env
# Environment variables override values in .env.

# LLM endpoint credentials. Fill only the profile you use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://spacetimeai.cc
# Optional named profiles allow model-specific gateway credentials to coexist.
OPENAI_API_KEY_LUNA=
OPENAI_BASE_URL_LUNA=https://spacetimeai.cc
OPENAI_API_KEY_TERRA=
OPENAI_BASE_URL_TERRA=https://spacetimeai.cc
OPENAI_API_KEY_DEEPSEEK=
OPENAI_BASE_URL_DEEPSEEK=https://discovery-api.intern-ai.org.cn/v1
OPENAI_API_KEY_SOL61=
OPENAI_BASE_URL_SOL61=https://api.diosirapi.co.uk/v1
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional: use a Python environment with MuJoCo installed for the simulator worker.
# MUJOCO_PYTHON=
